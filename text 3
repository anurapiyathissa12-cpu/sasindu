
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Alex Morgan | Creative Developer</title>

<meta name="description"
content="Personal portfolio of a creative developer specializing in futuristic web design, interactive experiences, and 3D websites.">

<style>

/* =========================================
   1. GLOBAL VARIABLES
========================================= */

:root {
    --bg: #07090f;
    --bg2: #0c101a;
    --card: rgba(17, 23, 36, 0.72);

    --cyan: #00f5ff;
    --purple: #9b5cff;
    --pink: #ff3cac;

    --text: #f3f6ff;
    --muted: #929bad;

    --border: rgba(255,255,255,0.09);

    --font: "Segoe UI", Arial, sans-serif;

    --radius: 20px;
    --max-width: 1200px;
}


/* =========================================
   2. RESET
========================================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    scroll-padding-top: 90px;
}

body {
    font-family: var(--font);
    background: var(--bg);
    color: var(--text);
    overflow-x: hidden;
    line-height: 1.6;
}

body.menu-open {
    overflow: hidden;
}

a {
    color: inherit;
    text-decoration: none;
}

button,
input,
textarea {
    font: inherit;
}

button {
    cursor: pointer;
}

img {
    max-width: 100%;
    display: block;
}

section {
    padding: 110px 24px;
    position: relative;
}

.container {
    width: 100%;
    max-width: var(--max-width);
    margin: auto;
}

::selection {
    background: var(--cyan);
    color: #000;
}


/* =========================================
   3. BACKGROUND EFFECTS
========================================= */

body::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: -2;

    background:
        radial-gradient(
            circle at 15% 20%,
            rgba(0,245,255,0.07),
            transparent 35%
        ),
        radial-gradient(
            circle at 85% 60%,
            rgba(155,92,255,0.08),
            transparent 40%
        );
}

#particles {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: -1;
}

.grid-background {
    position: absolute;
    inset: 0;
    pointer-events: none;

    background-image:
        linear-gradient(
            rgba(0,245,255,0.035) 1px,
            transparent 1px
        ),
        linear-gradient(
            90deg,
            rgba(0,245,255,0.035) 1px,
            transparent 1px
        );

    background-size: 60px 60px;

    mask-image: linear-gradient(
        to bottom,
        black,
        transparent 90%
    );
}


/* =========================================
   4. NAVIGATION
========================================= */

header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;

    z-index: 1000;

    background: rgba(7,9,15,0.8);
    backdrop-filter: blur(20px);

    border-bottom: 1px solid var(--border);
}

.navbar {
    max-width: var(--max-width);
    margin: auto;

    padding: 18px 24px;

    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo {
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -1px;
}

.logo span {
    color: var(--cyan);
}

.nav-links {
    display: flex;
    align-items: center;
    gap: 32px;
}

.nav-links a {
    color: var(--muted);
    font-size: 14px;

    transition: color 0.3s;
}

.nav-links a:hover {
    color: var(--cyan);
}

.nav-cta {
    border: 1px solid var(--cyan);
    padding: 10px 18px;
    border-radius: 50px;

    color: var(--cyan) !important;
}

.menu-toggle {
    display: none;

    border: none;
    background: none;
    color: white;

    font-size: 28px;
}


/* =========================================
   5. BUTTONS
========================================= */

.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;

    padding: 14px 24px;

    border-radius: 50px;

    font-size: 14px;
    font-weight: 600;

    transition:
        transform 0.3s,
        box-shadow 0.3s,
        background 0.3s;
}

.btn:hover {
    transform: translateY(-4px);
}

.btn-primary {
    color: #000;
    background: var(--cyan);

    box-shadow:
        0 0 20px rgba(0,245,255,0.2);
}

.btn-primary:hover {
    box-shadow:
        0 0 35px rgba(0,245,255,0.45);
}

.btn-outline {
    color: white;

    border: 1px solid var(--border);
    background: rgba(255,255,255,0.02);
}

.btn-outline:hover {
    border-color: var(--cyan);
}


/* =========================================
   6. HERO SECTION
========================================= */

.hero {
    min-height: 100vh;

    display: flex;
    align-items: center;

    padding-top: 130px;
    padding-bottom: 80px;

    overflow: hidden;
}

.hero-grid {
    display: grid;

    grid-template-columns: 1.1fr 0.9fr;

    align-items: center;
    gap: 60px;
}

.status {
    display: inline-flex;
    align-items: center;
    gap: 10px;

    padding: 8px 14px;

    border: 1px solid rgba(0,245,255,0.2);
    border-radius: 50px;

    background: rgba(0,245,255,0.04);

    font-size: 12px;
    color: var(--cyan);

    margin-bottom: 25px;
}

.status-dot {
    width: 7px;
    height: 7px;

    background: #00ff88;
    border-radius: 50%;

    box-shadow: 0 0 10px #00ff88;
}

.hero h1 {
    font-size: clamp(44px, 7vw, 88px);
    line-height: 1.05;

    letter-spacing: -4px;
    font-weight: 800;

    margin-bottom: 25px;
}

.gradient-text {
    background: linear-gradient(
        100deg,
        var(--cyan),
        var(--purple),
        var(--pink)
    );

    background-size: 200% 200%;

    -webkit-background-clip: text;
    background-clip: text;

    color: transparent;

    animation: gradientMove 6s ease infinite;
}

@keyframes gradientMove {
    0%,100% {
        background-position: 0% 50%;
    }

    50% {
        background-position: 100% 50%;
    }
}

.hero-description {
    max-width: 550px;

    color: var(--muted);

    font-size: 17px;
    line-height: 1.9;

    margin-bottom: 35px;
}

.hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
}

.hero-meta {
    display: flex;
    gap: 35px;

    margin-top: 50px;
}

.meta-item strong {
    display: block;
    font-size: 28px;
}

.meta-item span {
    color: var(--muted);
    font-size: 12px;
}


/* =========================================
   7. CSS 3D HERO OBJECT
========================================= */

.hero-visual {
    display: flex;
    align-items: center;
    justify-content: center;

    min-height: 460px;

    perspective: 1000px;

    position: relative;
}

.orbital-glow {
    position: absolute;

    width: 330px;
    height: 330px;

    border-radius: 50%;

    background:
        radial-gradient(
            circle,
            rgba(0,245,255,0.2),
            rgba(155,92,255,0.1),
            transparent 70%
        );

    filter: blur(20px);
}

.scene {
    width: 230px;
    height: 230px;

    perspective: 1000px;

    position: relative;

    transform-style: preserve-3d;
}

.cube {
    position: absolute;

    width: 100%;
    height: 100%;

    transform-style: preserve-3d;

    animation: cubeRotate 18s linear infinite;
}

.cube-face {
    position: absolute;

    width: 230px;
    height: 230px;

    border: 1px solid rgba(0,245,255,0.8);

    background:
        linear-gradient(
            135deg,
            rgba(0,245,255,0.08),
            rgba(155,92,255,0.12)
        );

    box-shadow:
        inset 0 0 30px rgba(0,245,255,0.1),
        0 0 20px rgba(0,245,255,0.08);

    display: flex;
    align-items: center;
    justify-content: center;

    backdrop-filter: blur(5px);
}

.cube-face span {
    font-size: 70px;
    color: var(--cyan);

    text-shadow:
        0 0 30px rgba(0,245,255,0.7);
}

.front {
    transform: translateZ(115px);
}

.back {
    transform: rotateY(180deg) translateZ(115px);
}

.right {
    transform: rotateY(90deg) translateZ(115px);
}

.left {
    transform: rotateY(-90deg) translateZ(115px);
}

.top {
    transform: rotateX(90deg) translateZ(115px);
}

.bottom {
    transform: rotateX(-90deg) translateZ(115px);
}

@keyframes cubeRotate {
    from {
        transform: rotateX(0deg) rotateY(0deg);
    }

    to {
        transform: rotateX(360deg) rotateY(360deg);
    }
}

.ring {
    position: absolute;

    width: 340px;
    height: 340px;

    border: 1px solid rgba(0,245,255,0.35);

    border-radius: 50%;

    transform: rotateX(65deg);

    animation: ringRotate 12s linear infinite;
}

.ring::before {
    content: "";

    position: absolute;
    inset: 20px;

    border: 1px dashed rgba(155,92,255,0.5);
    border-radius: 50%;
}

.ring-two {
    width: 390px;
    height: 390px;

    border-color: rgba(155,92,255,0.35);

    transform: rotateX(65deg) rotateY(55deg);

    animation-duration: 18s;
    animation-direction: reverse;
}

@keyframes ringRotate {
    from {
        rotate: 0deg;
    }

    to {
        rotate: 360deg;
    }
}

.floating-label {
    position: absolute;

    padding: 12px 18px;

    border: 1px solid var(--border);
    border-radius: 12px;

    background: rgba(12,16,26,0.85);
    backdrop-filter: blur(15px);

    font-size: 12px;
    color: var(--cyan);

    animation: float 4s ease-in-out infinite;
}

.label-one {
    top: 20%;
    right: 0;
}

.label-two {
    bottom: 15%;
    left: 0;

    animation-delay: 1s;
}

@keyframes float {
    0%,100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-15px);
    }
}


/* =========================================
   8. SECTION HEADINGS
========================================= */

.section-heading {
    margin-bottom: 60px;
}

.section-tag {
    color: var(--cyan);

    text-transform: uppercase;
    letter-spacing: 3px;

    font-size: 11px;
    font-weight: 700;

    margin-bottom: 15px;
}

.section-heading h2 {
    font-size: clamp(32px, 5vw, 55px);

    letter-spacing: -2px;
    line-height: 1.2;

    margin-bottom: 20px;
}

.section-heading p {
    max-width: 600px;

    color: var(--muted);
    font-size: 15px;
}


/* =========================================
   9. ABOUT SECTION
========================================= */

.about-grid {
    display: grid;

    grid-template-columns: 0.9fr 1.1fr;

    gap: 60px;
    align-items: center;
}

.about-card {
    position: relative;

    min-height: 400px;

    border: 1px solid var(--border);
    border-radius: var(--radius);

    background:
        linear-gradient(
            145deg,
            rgba(0,245,255,0.08),
            rgba(155,92,255,0.06)
        );

    overflow: hidden;

    display: flex;
    align-items: center;
    justify-content: center;
}

.about-card::before {
    content: "";

    position: absolute;

    width: 250px;
    height: 250px;

    background: var(--purple);
    opacity: 0.2;

    filter: blur(100px);
}

.about-avatar {
    position: relative;

    width: 160px;
    height: 160px;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 70px;

    border: 1px solid rgba(0,245,255,0.5);
    border-radius: 50%;

    background: rgba(0,245,255,0.04);

    box-shadow:
        0 0 50px rgba(0,245,255,0.1);
}

.about-content p {
    color: var(--muted);

    font-size: 15px;
    line-height: 1.9;

    margin-bottom: 20px;
}

.about-info {
    display: grid;

    grid-template-columns: repeat(2, 1fr);

    gap: 20px;
    margin-top: 30px;
}

.info-item {
    padding: 20px;

    background: var(--card);

    border: 1px solid var(--border);
    border-radius: 12px;
}

.info-item span {
    display: block;

    color: var(--muted);
    font-size: 11px;

    margin-bottom: 5px;
}

.info-item strong {
    font-size: 14px;
}


/* =========================================
   10. SKILLS SECTION
========================================= */

.skills-grid {
    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 20px;
}

.skill-card {
    padding: 30px;

    border: 1px solid var(--border);
    border-radius: var(--radius);

    background: var(--card);

    transition:
        transform 0.3s,
        border-color 0.3s;
}

.skill-card:hover {
    transform: translateY(-8px);

    border-color: rgba(0,245,255,0.4);
}

.skill-icon {
    width: 55px;
    height: 55px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 14px;

    background: rgba(0,245,255,0.08);

    font-size: 25px;
    color: var(--cyan);

    margin-bottom: 20px;
}

.skill-card h3 {
    font-size: 18px;
    margin-bottom: 10px;
}

.skill-card p {
    color: var(--muted);

    font-size: 13px;
    margin-bottom: 25px;
}

.skill-progress {
    height: 5px;

    background: rgba(255,255,255,0.06);

    border-radius: 10px;
    overflow: hidden;
}

.skill-progress span {
    display: block;

    height: 100%;
    width: 0;

    background: linear-gradient(
        90deg,
        var(--cyan),
        var(--purple)
    );

    border-radius: inherit;

    transition: width 1.5s ease;
}

.skill-percent {
    display: flex;
    justify-content: space-between;

    font-size: 11px;
    color: var(--muted);

    margin-top: 10px;
}


/* =========================================
   11. PROJECTS SECTION
========================================= */

.projects-grid {
    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 25px;
}

.project-card {
    position: relative;

    border: 1px solid var(--border);
    border-radius: var(--radius);

    background: var(--card);

    overflow: hidden;

    transform-style: preserve-3d;

    transition:
        transform 0.3s,
        border-color 0.3s;
}

.project-card:hover {
    border-color: rgba(0,245,255,0.45);
}

.project-visual {
    height: 220px;

    display: flex;
    align-items: center;
    justify-content: center;

    position: relative;

    overflow: hidden;

    background:
        radial-gradient(
            circle at center,
            rgba(0,245,255,0.14),
            rgba(155,92,255,0.08),
            transparent 75%
        );
}

.project-symbol {
    font-size: 65px;

    color: var(--cyan);

    text-shadow:
        0 0 40px rgba(0,245,255,0.5);

    transition: transform 0.4s;
}

.project-card:hover .project-symbol {
    transform: scale(1.2) rotate(10deg);
}

.project-content {
    padding: 25px;
}

.project-category {
    color: var(--cyan);

    font-size: 10px;
    text-transform: uppercase;

    letter-spacing: 2px;

    margin-bottom: 10px;
}

.project-content h3 {
    font-size: 20px;
    margin-bottom: 12px;
}

.project-content p {
    color: var(--muted);

    font-size: 13px;
    line-height: 1.8;

    margin-bottom: 20px;
}

.project-tags {
    display: flex;
    flex-wrap: wrap;

    gap: 8px;
}

.project-tags span {
    padding: 6px 10px;

    border: 1px solid var(--border);
    border-radius: 50px;

    color: var(--muted);

    font-size: 10px;
}


/* =========================================
   12. EXPERIENCE TIMELINE
========================================= */

.timeline {
    position: relative;

    max-width: 850px;
    margin: auto;
}

.timeline::before {
    content: "";

    position: absolute;

    left: 12px;
    top: 0;
    bottom: 0;

    width: 1px;

    background: linear-gradient(
        to bottom,
        var(--cyan),
        var(--purple),
        transparent
    );
}

.timeline-item {
    position: relative;

    padding-left: 55px;
    margin-bottom: 45px;
}

.timeline-dot {
    position: absolute;

    left: 5px;
    top: 8px;

    width: 15px;
    height: 15px;

    border-radius: 50%;

    background: var(--cyan);

    box-shadow:
        0 0 15px rgba(0,245,255,0.5);
}

.timeline-card {
    padding: 30px;

    border: 1px solid var(--border);
    border-radius: var(--radius);

    background: var(--card);
}

.timeline-date {
    color: var(--cyan);

    font-size: 11px;
    letter-spacing: 1px;

    margin-bottom: 10px;
}

.timeline-card h3 {
    font-size: 20px;
    margin-bottom: 5px;
}

.timeline-card h4 {
    color: var(--muted);

    font-size: 13px;
    font-weight: 400;

    margin-bottom: 15px;
}

.timeline-card p {
    color: var(--muted);

    font-size: 14px;
    line-height: 1.8;
}


/* =========================================
   13. CONTACT SECTION
========================================= */

.contact-grid {
    display: grid;

    grid-template-columns: 0.9fr 1.1fr;

    gap: 50px;
}

.contact-info h3 {
    font-size: 30px;
    margin-bottom: 20px;
}

.contact-info > p {
    color: var(--muted);

    font-size: 14px;
    line-height: 1.9;

    margin-bottom: 35px;
}

.contact-method {
    display: flex;
    align-items: center;

    gap: 15px;

    margin-bottom: 20px;
}

.contact-icon {
    width: 50px;
    height: 50px;

    display: flex;
    align-items: center;
    justify-content: center;

    border: 1px solid var(--border);
    border-radius: 12px;

    color: var(--cyan);
    background: var(--card);
}

.contact-method span {
    display: block;

    color: var(--muted);
    font-size: 11px;
}

.contact-method strong {
    font-size: 14px;
}

.contact-form {
    padding: 35px;

    border: 1px solid var(--border);
    border-radius: var(--radius);

    background: var(--card);
}

.form-group {
    margin-bottom: 20px;
}

.form-group label {
    display: block;

    font-size: 12px;

    margin-bottom: 10px;
}

.form-group input,
.form-group textarea {
    width: 100%;

    padding: 14px 16px;

    border: 1px solid var(--border);
    border-radius: 10px;

    background: rgba(255,255,255,0.025);

    color: white;

    outline: none;

    transition: border-color 0.3s;
}

.form-group input:focus,
.form-group textarea:focus {
    border-color: var(--cyan);
}

.form-group textarea {
    min-height: 140px;

    resize: vertical;
}

.form-group input::placeholder,
.form-group textarea::placeholder {
    color: #626b7e;
}

.contact-form .btn {
    width: 100%;
    border: none;
}

.form-message {
    margin-top: 15px;

    font-size: 13px;
    color: var(--cyan);
}


/* =========================================
   14. FOOTER
========================================= */

footer {
    border-top: 1px solid var(--border);

    padding: 30px 24px;
}

.footer-content {
    max-width: var(--max-width);
    margin: auto;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 20px;
}

.footer-content p {
    color: var(--muted);
    font-size: 12px;
}

.footer-links {
    display: flex;
    gap: 20px;
}

.footer-links a {
    color: var(--muted);
    font-size: 12px;

    transition: color 0.3s;
}

.footer-links a:hover {
    color: var(--cyan);
}


/* =========================================
   15. SCROLL ANIMATIONS
========================================= */

.reveal {
    opacity: 0;

    transform: translateY(35px);

    transition:
        opacity 0.8s ease,
        transform 0.8s ease;
}

.reveal.visible {
    opacity: 1;
    transform: translateY(0);
}


/* =========================================
   16. RESPONSIVE DESIGN
========================================= */

@media (max-width: 1000px) {

    .hero-grid {
        grid-template-columns: 1fr 0.8fr;
        gap: 20px;
    }

    .hero h1 {
        font-size: 60px;
    }

    .hero-visual {
        transform: scale(0.8);
    }

    .skills-grid,
    .projects-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .about-grid {
        gap: 35px;
    }
}


@media (max-width: 768px) {

    section {
        padding: 80px 20px;
    }

    .navbar {
        padding: 16px 20px;
    }

    .menu-toggle {
        display: block;
    }

    .nav-links {
        position: fixed;

        top: 70px;
        left: 0;
        right: 0;
        bottom: 0;

        height: calc(100dvh - 70px);

        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;

        gap: 30px;

        background: rgba(7,9,15,0.98);
        backdrop-filter: blur(20px);

        transform: translateX(100%);

        transition: transform 0.4s ease;
    }

    .nav-links.active {
        transform: translateX(0);
    }

    .nav-links a {
        font-size: 20px;
    }

    .hero {
        padding-top: 130px;
    }

    .hero-grid {
        grid-template-columns: 1fr;
        text-align: center;
    }

    .hero-description {
        margin-left: auto;
        margin-right: auto;
    }

    .hero-buttons {
        justify-content: center;
    }

    .hero-meta {
        justify-content: center;
    }

    .hero-visual {
        min-height: 380px;
        margin-top: 20px;

        transform: scale(0.8);
    }

    .hero h1 {
        letter-spacing: -2px;
    }

    .about-grid,
    .contact-grid {
        grid-template-columns: 1fr;
    }

    .about-card {
        min-height: 300px;
    }

